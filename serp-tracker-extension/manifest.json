{
  "manifest_version": 3,
  "name": "SERP Rank Tracker",
  "version": "1.4.3",
  "description": "Tracks organic and sponsored ranks on Amazon search pages, brand share, untargeted competitors, and exports product details to CSV.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SERP Rank Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/s?*",
        "https://www.amazon.ca/s?*",
        "https://www.amazon.co.uk/s?*",
        "https://www.amazon.com.mx/s?*"
      ],
      "js": [
        "export.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/dp/*",
        "https://www.amazon.com/*/dp/*",
        "https://www.amazon.com/gp/product/*",
        "https://www.amazon.ca/dp/*",
        "https://www.amazon.ca/*/dp/*",
        "https://www.amazon.ca/gp/product/*",
        "https://www.amazon.co.uk/dp/*",
        "https://www.amazon.co.uk/*/dp/*",
        "https://www.amazon.co.uk/gp/product/*",
        "https://www.amazon.com.mx/dp/*",
        "https://www.amazon.com.mx/*/dp/*",
        "https://www.amazon.com.mx/gp/product/*"
      ],
      "js": [
        "export.js",
        "pdp.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
